{
	"mcpServers": {
		"context7": {
			"command": "npx",
			"args": ["-y", "@upstash/context7-mcp"]
		},
		"chrome-devtools": {
			"command": "npx",
			"args": ["-y", "chrome-devtools-mcp@latest"]
		},
		"figma-official": {
			"url": "https://mcp.figma.com/mcp"
		},
		"atlassian-official": {
			"url": "https://mcp.atlassian.com/v2/mcp"
		},
		"git": {
			"type": "stdio",
			"command": "uvx",
			"args": ["--with", "mcp<2", "mcp-server-git"],
			"env": { "GIT_CONFIG_GLOBAL": "/dev/null" }
		}
	}
}
