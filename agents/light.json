{
	"name": "light",
	"description": "General-purpose agent for answering questions, looking things up, and making small changes",
	"model": "claude-opus-4.8",
	"tools": ["*"],
	"allowedTools": [
		"@builtin",
		"@context7",
		"@exa",
		"@atlassian",
		"@figma-developer-mcp",
		"@git",
		"@chrome-devtools",
		"@doc-retrieval"
	],
	"toolsSettings": {
		"write": {
			"deniedPaths": [".plan/**/task-edit-approved"]
		},
		"subagent": {
			"availableAgents": ["worker"],
			"trustedAgents": ["worker"]
		}
	},
	"hooks": {
		"preToolUse": [
			{
				"matcher": "write",
				"command": "~/.kiro/hooks/task_edit/validate-task-edit-approval.js"
			}
		],
		"stop": [
			{
				"command": "~/.kiro/hooks/cmux-notify.sh",
				"description": "Notify via cmux when response completes"
			},
			{
				"command": "~/.kiro/hooks/task_edit/reset-task-edit-approval.js",
				"description": "Reset task-edit-approved control files to false at end of turn"
			}
		],
		"postToolUse": [
			{
				"matcher": "fs_write",
				"command": "~/.kiro/hooks/post-write-format.sh"
			}
		]
	},
	"resources": [
		"file:///Users/peanu/.kiro/steering/*.md",
		"file:///Users/peanu/.kiro/skills/*/SKILL.md",

		"file://.kiro/steering/*.md",
		"skill://.kiro/skills/*/SKILL.md",

		"file://README.md",
		"file://package.json"
	],
	"prompt": "file:///Users/peanu/.kiro/agents/light.md",
	"includeMcpJson": true
}
